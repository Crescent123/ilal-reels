6894531, "يسولو، باش ما يسمعوش الجواب."], [35.41999816894531, 36.76999855041504, "الحل ساهل فالكلام،"], [36.76999855041504, 38.119998931884766, "صعيب فالقلب: سول."], [38.119998931884766, 39.39297165741792, "«أنا بغيت علاقة"], [39.39297165741792, 41.2599983215332, "واضحة. نتا فين واقف؟»"], [41.2599983215332, 42.70499897003174, "ماشي تهديد، وماشي"], [42.70499897003174, 43.97999954223633, "ضغط. غير وضوح."], [43.97999954223633, 45.06500034332275, "إلا كان الجواب"], [45.06500034332275, 47.08000183105469, "نعم، مبروك، ربحتي الأمان."], [47.08000183105469, 48.02737025210732, "وإلا كان لا،"], [48.02737025210732, 50.08000183105469, "توجعتي مرة وحدة، وتحررتي."], [50.08000183105469, 50.97828717912947, "أحسن من شهور"], [50.97828717912947, 52.70000076293945, "ديال الانتظار فالضباب."], [52.70000076293945, 54.068001174926756, "حيت اللي بغاك بصح،"], [54.068001174926756, 55.7400016784668, "ما كيخليكش تسول بزاف."], [55.7400016784668, 57.63538513183594, "ونتوما؟ عشتو علاقة بلا"], [57.63538513183594, 60.21999893188477, "سمية؟ سولتو ولا بقيتو ساكتين؟"]], "dur": 60.91999893188476}