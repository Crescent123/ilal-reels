{"s": [0, 4.579999923706055, 12.300000190734863, 21.040000915527344, 32.220001220703125, 39.459999084472656], "t": [0.0, 3.0399999618530273, 4.579999923706055, 6.21999979019165, 8.119999885559082, 9.359999656677246, 12.300000190734863, 15.119999885559082, 17.100000381469727, 18.6200008392334, 21.040000915527344, 22.780000686645508, 25.0, 26.600000381469727, 27.65999984741211, 29.15999984741211, 30.959999084472656, 32.220001220703125, 34.31999969482422, 35.84000015258789, 38.459999084472656, 39.459999084472656, 41.13999938964844, 42.5, 44.41999816894531, 45.119998931884766], "cap": [[0.0, 1.3432557970978494, "زمان، الراجل والمرا"], [1.3432557970978494, 3.0399999618530273, "كانو موقعين واحد العقد…"], [3.0399999618530273, 4.579999923706055, "حتى واحد ما كتبو."], [4.579999923706055, 6.21999979019165, "هو كيخدم ويجيب الفلوس،"], [6.21999979019165, 8.119999885559082, "وهي كتدبر الدار والولاد."], [8.119999885559082, 9.359999656677246, "ماشي ديما كان عادل…"], [9.359999656677246, 10.631351238972432, "ولكن كل واحد كان"], [10.631351238972432, 12.300000190734863, "عارف شنو كيتسنى منو."], [12.300000190734863, 13.960000038146973, "دابا، بجوج خدامين،"], [13.960000038146973, 15.119999885559082, "بجوج عيانين،"], [15.119999885559082, 15.968571526663643, "وبجوج راجعين"], [15.968571526663643, 17.100000381469727, "للدار على سبعة."], [17.100000381469727, 18.6200008392334, "والعقد القديم؟ تقطع…"], [18.6200008392334, 19.91066754659017, "وما تكتبش بلاصتو"], [19.91066754659017, 21.040000915527344, "حتى عقد جديد."], [21.040000915527344, 22.780000686645508, "وهنا كيبدا الحساب فالسر:"], [22.780000686645508, 23.81999969482422, "«أنا خدمت كثر»،"], [23.81999969482422, 25.0, "«أنا تعبت كثر»."], [25.0, 26.600000381469727, "الباحثين كيسميو هادشي"], [26.600000381469727, 27.65999984741211, "العبء الذهني:"], [27.65999984741211, 29.15999984741211, "الشغل اللي ما كيبانش،"], [29.15999984741211, 29.904827117919922, "بحال التفكير"], [29.904827117919922, 30.959999084472656, "فشنو غادي ناكلو،"], [30.959999084472656, 32.220001220703125, "وشكون غادي يخلص الضو."], [32.220001220703125, 32.99000066121419, "المشكل ماشي"], [32.99000066121419, 34.31999969482422, "فالمرا اللي خدامة،"], [34.31999969482422, 35.84000015258789, "وماشي فالراجل اللي تبدل."], [35.84000015258789, 36.74062478542328, "المشكل أننا"], [36.74062478542328, 38.459999084472656, "عايشين بقواعد جديدة…"], [38.459999084472656, 39.459999084472656, "بعقد قديم."], [39.459999084472656, 41.13999938964844, "جلسو وكتبو العقد ديالكم:"], [41.13999938964844, 42.5, "شكون كيدير شنو."], [42.5, 43.720001220703125, "حيت اللي ما كيتقالش…"], [43.720001220703125, 44.41999816894531, "كيتحسب."], [44.41999816894531, 45.119998931884766, "ونتوما؟"], [45.119998931884766, 46.380001068115234, "عندكم العقد القديم…"], [46.380001068115234, 47.820001220703126, "ولا الجديد؟"]], "dur": 48.52000122070312}