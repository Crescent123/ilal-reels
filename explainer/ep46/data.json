2727199901234, "سافرو لبلاصة عمركم"], [33.12727199901234, 34.29999923706055, "ما مشيتو ليها،"], [34.29999923706055, 35.057141712733674, "طيبو ماكلة"], [35.057141712733674, 36.41999816894531, "عمركم ما طيبتوها،"], [36.41999816894531, 37.36864687945392, "ولا تعلمو رياضة"], [37.36864687945392, 38.7599983215332, "ولا لعبة مع بعضياتكم."], [38.7599983215332, 39.529998461405434, "حيت التجربة"], [39.529998461405434, 41.279998779296875, "الجديدة كترجع الدوبامين،"], [41.279998779296875, 42.668332735697426, "والعقل كيربطها بالشخص"], [42.668332735697426, 43.65999984741211, "اللي كان معاك."], [43.65999984741211, 45.18727215853605, "والذكريات الجديدة،"], [45.18727215853605, 46.459999084472656, "كتصنع حب جديد."], [46.459999084472656, 48.309018692315796, "ونتوما؟ آخر مرة درتو شي"], [48.309018692315796, 50.55999908447266, "حاجة جديدة بجوج، إمتا كانت؟"]], "dur": 51.25999908447265}