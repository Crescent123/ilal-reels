5469, 44.49636540268407, "علاش اخترت هاد"], [44.49636540268407, 45.7400016784668, "الشخص، وعلاش بقيت؟"], [45.7400016784668, 47.45929912098667, "تحمّل المسؤولية ماشي ضعف،"], [47.45929912098667, 49.65999984741211, "هي اللي كتحميك فالعلاقة الجاية."], [49.65999984741211, 51.77591881265446, "ونتوما؟ الإكس ديالكم كان"], [51.77591881265446, 53.980001068115236, "بصح نرجسي، ولا غير خايب؟"]], "dur": 54.68000106811523}