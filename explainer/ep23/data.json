 [38.56000082833426, 40.400001525878906, "فالتيليفون، وهي حتى هي."], [40.400001525878906, 41.752000427246095, "الشريك ما محتاجش"], [41.752000427246095, 43.779998779296875, "وقتك كامل، محتاج حضورك."], [43.779998779296875, 44.93199920654297, "عطيه عشر دقايق"], [44.93199920654297, 46.65999984741211, "كل نهار… وشوف الفرق."], [46.65999984741211, 47.88926752602182, "ونتوما؟ شحال من"], [47.88926752602182, 50.019998168945314, "دقيقة كتعطيو بلا تيليفون؟"]], "dur": 50.71999816894531}