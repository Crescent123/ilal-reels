31086077, 37.599998474121094, "فالنفس، والتعجيز ماشي قيمة."], [37.599998474121094, 39.734399948120114, "الوسط هو: بيّن الاهتمام"], [39.734399948120114, 42.2400016784668, "ديالك، وشوف واش كيرجع ليك."], [42.2400016784668, 43.70571517944336, "إلا رجع، زيد. وإلا"], [43.70571517944336, 45.65999984741211, "ما رجعش، حبس بلا دراما."], [45.65999984741211, 46.663333892822266, "الحب ماشي ماتش"], [46.663333892822266, 48.2400016784668, "بين الرجال والعيالات."], [48.2400016784668, 49.599998474121094, "هو فريق ديال جوج."], [49.599998474121094, 51.3, "ونتوما؟ شكون عطاكم"], [51.3, 53.00000152587891, "أخيب نصيحة فالحب؟"]], "dur": 53.7000015258789}