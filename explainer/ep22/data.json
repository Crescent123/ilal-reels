71, 37.0, "اللي عجبو من النهار الأول."], [37.0, 38.17454580827193, "هادي ماشي أنانية،"], [38.17454580827193, 40.040000915527344, "هادي طاقة كتزيدها للعلاقة."], [40.040000915527344, 42.13762716519631, "والعكس صحيح: إلا الشريك عندو"], [42.13762716519631, 44.459999084472656, "حياتو، فرح ليه وما تغيرش منها."], [44.459999084472656, 46.02000045776367, "بغي شريكك… ولكن"], [46.02000045776367, 47.58000183105469, "بغي حتى حياتك."], [47.58000183105469, 48.87729813859269, "ونتوما؟ شنو اللي"], [48.87729813859269, 50.57999954223633, "كيجذبكم كثر فالشريك؟"]], "dur": 51.279999542236325}