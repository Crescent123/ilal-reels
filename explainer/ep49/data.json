016, 35.400001525878906, "بلا ما تهضر: نتا مهم عندي."], [35.400001525878906, 36.81999969482422, "حط التيليفون فاش كيهضر،"], [36.81999969482422, 38.68000030517578, "ما تعطيش الحل حتى يطلبو،"], [38.68000030517578, 39.556128717237904, "وسول سؤال ثاني"], [39.556128717237904, 40.619998931884766, "على نفس الموضوع."], [40.619998931884766, 42.26893631955411, "ومع الوقت، غادي يولي يحكي"], [42.26893631955411, 43.720001220703125, "ليك قبل حتى واحد آخر."], [43.720001220703125, 45.77454584295099, "ونتوما؟ واش الشريك ديالكم"], [45.77454584295099, 48.23999938964844, "كيدخل لعالمكم، ولا كيبقى برا؟"]], "dur": 48.939999389648435}