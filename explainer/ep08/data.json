3719635, "عطي، وشوف واش"], [35.11687433719635, 36.34000015258789, "كيرجع ليك شي حاجة."], [36.34000015258789, 37.64307608971229, "ماشي بالميليمتر… ماشي"], [37.64307608971229, 38.7599983215332, "حساب ديال البقال."], [38.7599983215332, 39.98947284096166, "اللي كيحسب كلشي،"], [39.98947284096166, 41.68000030517578, "كيقتل العلاقة حتى هو."], [41.68000030517578, 42.54666752285428, "ولكن إلا كنتي"], [42.54666752285428, 44.08000183105469, "ديما بوحدك اللي كتجدف…"], [44.08000183105469, 45.61658719690835, "هضر بهدوء: «محتاج نحس"], [45.61658719690835, 47.08000183105469, "بلي حتى نتا معايا.»"], [47.08000183105469, 47.75227373296564, "إلا تبدل شي حاجة،"], [47.75227373296564, 48.81999969482422, "مزيان. وإلا لا، راه جاوبك."], [48.81999969482422, 50.49545470151034, "العلاقة الصحية: جوج"], [50.49545470151034, 52.70000076293945, "كيجدفو، ماشي واحد كيغرق."], [52.70000076293945, 54.967692360511194, "ونتوما؟ شكون فيكم اللي"], [54.967692360511194, 58.05999908447266, "كيعطي كثر؟ وواش الميزان عادل؟"]], "dur": 58.75999908447265}