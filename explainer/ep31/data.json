29.472727862271395, 31.1200008392334, "خايفش، ما عندي ما نخبي."], [31.1200008392334, 32.56347813813583, "ولكن رد البال: هادشي"], [32.56347813813583, 34.439998626708984, "ماشي معناه ما تشرحش أبدا."], [34.439998626708984, 35.58399887084961, "إلا غلطتي بصح،"], [35.58399887084961, 37.29999923706055, "اعترف بلا لف ودوران."], [37.29999923706055, 38.79411742266487, "الاعتراف القصير أقوى"], [38.79411742266487, 39.84000015258789, "من مية تبرير."], [39.84000015258789, 40.97400035858154, "والشريك اللي كيطلب"], [40.97400035858154, 42.36000061035156, "التبرير على كل دقيقة،"], [42.36000061035156, 43.44947363200941, "هنا المشكل ماشي"], [43.44947363200941, 45.119998931884766, "فالشرح… المشكل فالثقة."], [45.119998931884766, 46.308570161157725, "الثقة ما كتتبناش"], [46.308570161157725, 48.7599983215332, "بالكلام الكثير، كتتبنى بالأفعال."], [48.7599983215332, 50.126189004807244, "قول الصح، ودير اللي"], [50.126189004807244, 51.779998779296875, "قلتي، وخلي الوقت يهضر."], [51.779998779296875, 53.4066653781467, "حيت اللي كيبرر بزاف،"], [53.4066653781467, 55.439998626708984, "كيولي متهم حتى وهو بريء."], [55.439998626708984, 57.04199993133545, "ونتوما؟ كتبرر بزاف"], [57.04199993133545, 59.00000152587891, "ولا كتقولها مرة وحدة؟"]], "dur": 59.7000015258789}