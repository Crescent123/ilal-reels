4.880001068115234, "v": {"fx": "", "w": "point smile", "r": "away sad", "x": true, "top": ["تفلية ❌", "r"]}}, {"a": 44.880001068115234, "b": 46.040000915527344, "v": {"w": "chest", "r": "down", "bw": "سمعتك… كمّلي 👂"}}, {"a": 46.040000915527344, "b": 49.68000030517578, "v": {"L": "text", "big": [["فوقتها ✅", "gr", 90], ["فغير وقتها ❌", "r", 90]]}}, {"a": 49.68000030517578, "b": 52.39999923706055, "v": {"L": "cta", "w": "point smile", "r": "point smile", "fx": "", "big": [["ونتوما؟", "w", 110], ["كتضحكو ولا كتدافعو؟ 😂", "g", 62]], "by": 640, "cta": "قولوها فالكومونطير 👇"}}], "cap": [[0.0, 1.0966666407055325, "واش كتعرف تخرج"], [1.0966666407055325, 2.819999933242798, "من خصومة تافهة بضحكة؟"], [2.819999933242798, 3.8822856085641044, "مثلا هي كتقول"], [3.8822856085641044, 5.679999828338623, "ليه: «نتا ديما معطل!»"], [5.679999828338623, 7.018139484316803, "وهو كيبدا يدافع: «لا،"], [7.018139484316803, 8.420000076293945, "غير البارح جيت بكري!»"], [8.420000076293945, 9.531250059604645, "وتبدا المحكمة…"], [9.531250059604645, 10.960000038146973, "ساعة ديال الدفاع."], [10.960000038146973, 12.064000129699707, "كاين حل آخر:"], [12.064000129699707, 14.180000305175781, "تتافق معاها وتزيد فيه."], [14.180000305175781, 15.757333246866862, "«معطل؟ أنا ما كنوصلش…"], [15.757333246866862, 17.559999465942383, "أنا كنبان بحال الهلال!»"], [17.559999465942383, 18.344799575805663, "هي كتضحك،"], [18.344799575805663, 19.739999771118164, "والخصومة كتطيح."], [19.739999771118164, 20.6036359613592, "ونفس الشي كيخدم"], [20.6036359613592, 21.639999389648438, "من الجيهة الأخرى."], [21.639999389648438, 22.57081057574298, "هو كيقول ليها:"], [22.57081057574298, 24.100000381469727, "«نتي ديما فالتيليفون!»"], [24.100000381469727, 27.781177071964038, "وهي كتجاوب: «إيه، أنا"], [27.781177071964038, 33.040000915527344, "وياه مخطوبين، والعرس فالصيف.»"], [33.040000915527344, 34.37513526710304, "الضحك كيقول: سمعتك،"], [34.37513526710304, 35.63999938964844, "وما بغيتش نتحارب."], [35.63999938964844, 37.09618922642299, "حيت الدفاع كيخلي الآخر"], [37.09618922642299, 38.41999816894531, "يحس بلي ما سمعتيهش."], [38.41999816894531, 38.95845970740685, "ولكن رد البال:"], [38.95845970740685, 39.91999816894531, "هادي غير للحوايج الصغار."], [39.91999816894531, 41.14926668492759, "إلا كان المشكل كبير،"], [41.14926668492759, 42.439998626708984, "ولا الآخر مجروح بصح،"], [42.439998626708984, 43.30580594462733, "الضحك كيولي"], [43.30580594462733, 44.880001068115234, "تفلية، وكيزيد يجرح."], [44.880001068115234, 45.23692409808819, "تما خاصك"], [45.23692409808819, 46.040000915527344, "تسمع وتهضر بالجد."], [46.040000915527344, 47.967059415929455, "الضحكة فوقتها كتسالي خصومة،"], [47.967059415929455, 49.68000030517578, "وفغير وقتها كتبدا وحدة."], [49.68000030517578, 50.737777667575415, "ونتوما؟ كتضحكو"], [50.737777667575415, 52.39999923706055, "ولا كتدافعو فالخصومة؟"]], "dur": 53.099999237060544}