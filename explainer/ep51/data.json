05729, 37.900001525878906, "خدمتك، عندك أحلامك."], [37.900001525878906, 38.85333429972331, "ومن بعد رجع"], [38.85333429972331, 40.5, "ليه وعندك ما تحكي."], [40.5, 41.93000030517578, "بغيه بزاف… ولكن"], [41.93000030517578, 43.36000061035156, "ما تنساش راسك."], [43.36000061035156, 45.34610166388043, "حيت اللي كيعرف يبغي راسو، كيعرف"], [45.34610166388043, 47.13999938964844, "يبغي شي حد آخر بلا ما يضيع."], [47.13999938964844, 48.71533289591471, "ونتوما؟ واش عمركم"], [48.71533289591471, 49.91999969482422, "ذبتو فشي حد؟"]], "dur": 50.619999694824216}