.02000045776367, 33.71609794802782, "اللعب الصغير كيقرب،"], [33.71609794802782, 35.68000030517578, "والتلاعب كيهرس الثقة."], [35.68000030517578, 36.39999961853027, "والسؤال اللي"], [36.39999961853027, 37.599998474121094, "كيفرق بيناتهم ساهل."], [37.599998474121094, 39.0509791654699, "واش هاد الحركة كتخلي"], [39.0509791654699, 41.29999923706055, "الآخر يحس بالأمان، ولا بالخوف؟"], [41.29999923706055, 42.61024307623142, "إلا كان الجواب هو"], [42.61024307623142, 44.459999084472656, "الخوف، وقف اللعبة دابا."], [44.459999084472656, 45.57428577968052, "وقول اللي بغيتي"], [45.57428577968052, 47.58000183105469, "نيشان: توحشتك، بغيت نشوفك."], [47.58000183105469, 49.36723587360788, "الصراحة ما فيهاش حماس"], [49.36723587360788, 51.58000183105469, "الغموض، ولكن فيها الراحة."], [51.58000183105469, 53.510170784643144, "ونتوما؟ شنو هي اللعبة اللي"], [53.510170784643144, 55.960000610351564, "كتلعبوها، وخا كتقولو ما كنلعبوش؟"]], "dur": 56.66000061035156}