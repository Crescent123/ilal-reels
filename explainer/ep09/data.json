 "ثلاثة: خود"], [38.55999883015951, 39.7599983215332, "استراحة قصيرة ورجع."], [39.7599983215332, 41.01624846458435, "وهادشي ماشي غير"], [41.01624846458435, 42.439998626708984, "على اللي كيطرطق."], [42.439998626708984, 43.64685723440988, "واللي ديما هادئ،"], [43.64685723440988, 45.08000183105469, "ممكن كيبلع مشاعرو."], [45.08000183105469, 46.388294313012096, "وحتى هو خاصو يتعلم"], [46.388294313012096, 48.060001373291016, "يقول: «حتى أنا مجروح.»"], [48.060001373291016, 49.08972992768159, "الهدف ماشي واحد"], [49.08972992768159, 50.599998474121094, "يولي طبيب ديال الآخر…"], [50.599998474121094, 52.57531819445022, "الهدف جوج كيعرفو يرجعو"], [52.57531819445022, 54.81999969482422, "للهدوء، ومن بعد يتلاقاو."], [54.81999969482422, 56.44249906539917, "ونتوما؟ شكون فيكم اللي"], [56.44249906539917, 58.359998321533205, "كيطرطق، وشكون اللي كيطفي؟"]], "dur": 59.0599983215332}