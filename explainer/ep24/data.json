e", "w": "hug smile", "r": "hug smile", "fx": "hearts", "burst": "w"}}, {"a": 40.58000183105469, "b": 43.84000015258789, "v": {"L": "text", "fx": "", "big": [["الكوموند: نص ساعة 🛵", "w", 70], ["الحب: سنين ❤️", "p", 90]]}}, {"a": 43.84000015258789, "b": 47.460000610351564, "v": {"L": "cta", "w": "point smile", "r": "point smile", "fx": "", "big": [["ونتوما؟", "w", 110], ["تصبر ولا تبدّل؟ 🤔", "g", 66]], "by": 640, "cta": "قولوها فالكومونطير 👇"}}], "cap": [[0.0, 1.4762790646663932, "علاش ولّينا باغيين الحب"], [1.4762790646663932, 2.759999990463257, "يجي بحال شي كوموند؟"], [2.759999990463257, 3.6559999148050943, "الماكلة كتوصلك"], [3.6559999148050943, 4.679999828338623, "للباب فنص ساعة،"], [4.679999828338623, 6.460000038146973, "الفيلم كتختارو بصبعك،"], [6.460000038146973, 7.846046336861544, "وحتى الناس… كتدوّزهم"], [7.846046336861544, 9.4399995803833, "يمين وليسر فالتيليفون."], [9.4399995803833, 10.272857052939278, "تعوّدنا على"], [10.272857052939278, 11.5600004196167, "كلشي ساهل وسريع."], [11.5600004196167, 12.160000377231174, "وبغينا حتى"], [12.160000377231174, 13.180000305175781, "الحب يكون بحالو."], [13.180000305175781, 14.691915106266103, "أول مشكل، أول خلاف…"], [14.691915106266103, 16.920000076293945, "سالينا، نقلبو على واحد آخر."], [16.920000076293945, 17.959024522362686, "بحال إلا الشريك"], [17.959024522362686, 19.760000228881836, "سلعة: ما عجباتكش، رجّعها."], [19.760000228881836, 20.818536944505645, "ولكن الحب ماشي"], [20.818536944505645, 22.860000610351562, "حاجة كتشريها، الحب كتبنيه."], [22.860000610351562, 23.622667249043783, "بحال الدار:"], [23.622667249043783, 24.940000534057617, "ياجورة على ياجورة."], [24.940000534057617, 26.208571570260183, "كل خلاف كتحلّوه مع"], [26.208571570260183, 27.899999618530273, "بعض، كيزيد يقوّي الساس."], [27.899999618530273, 29.130000114440918, "والصبر هنا ماشي"], [29.130000114440918, 30.360000610351562, "ضعف، هو القوة."], [30.360000610351562, 31.281600952148438, "واللي صبر على شي"], [31.281600952148438, 33.2400016784668, "حاجة وبناها، كيعرف القيمة ديالها."], [33.2400016784668, 34.051283127222305, "وهادي على جوج:"], [34.051283127222305, 35.5, "الراجل والمرا بحال بحال."], [35.5, 36.69351278769003, "ما كاينش شي واحد"], [36.69351278769003, 38.2599983215332, "كامل غادي يجيك واجد."], [38.2599983215332, 39.21999977374899, "كاين شي واحد"], [39.21999977374899, 40.58000183105469, "مستعد يبني معاك."], [40.58000183105469, 41.977143968854634, "الكوموند كتوصل فنص"], [41.977143968854634, 43.84000015258789, "ساعة… والحب كيبغي سنين."], [43.84000015258789, 45.51076959463266, "ونتوما؟ كتصبرو ولا"], [45.51076959463266, 47.460000610351564, "كتقلبو على واحد آخر؟"]], "dur": 48.16000061035156}