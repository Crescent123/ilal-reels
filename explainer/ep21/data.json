3633, "دار، والباب ديما محلول."], [40.97999954223633, 42.43283059462061, "واللي بقا معاك غير حيت ما"], [42.43283059462061, 44.060001373291016, "لقاش فين يمشي، راه ماشي حب."], [44.060001373291016, 44.716924080481895, "الحب هو"], [44.716924080481895, 46.5, "يقدر يمشي… وكيبقى."], [46.5, 48.38461620624249, "ونتوما؟ كتعطيو الحرية"], [48.38461620624249, 50.00000152587891, "ولا كتسدّو الباب؟"]], "dur": 50.7000015258789}