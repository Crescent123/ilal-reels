1110594007706, "«أنا بغيتك… ولكن إلا"], [30.431110594007706, 32.119998931884766, "مشيتي، غادي نكون مزيان.»"], [32.119998931884766, 33.329999923706055, "هادي ماشي برودة،"], [33.329999923706055, 34.540000915527344, "هادي ثقة فراسك."], [34.540000915527344, 35.721500396728516, "واللي واثق فراسو،"], [35.721500396728516, 37.31999969482422, "كيخلي الآخر حر يختارو."], [37.31999969482422, 38.673142133440294, "وفاش كيختارك وهو"], [38.673142133440294, 40.279998779296875, "حر… هاداك هو الحب."], [40.279998779296875, 41.463783367260085, "كيفاش تبدا؟ ملي"], [41.463783367260085, 43.20000076293945, "يجيك الخوف، سول راسك:"], [43.20000076293945, 44.39183675026407, "واش هاد الخوف جاي من"], [44.39183675026407, 46.119998931884766, "الواقع… ولا من الماضي ديالي؟"], [46.119998931884766, 47.730475743611656, "وعمّر حياتك: صحابك،"], [47.730475743611656, 49.68000030517578, "خدمتك، الهوايات ديالك."], [49.68000030517578, 50.93272769812381, "باش الحب يكون"], [50.93272769812381, 52.86000061035156, "زيادة… ماشي أكسجين."], [52.86000061035156, 54.41102132991869, "ونتوما؟ واش الخوف من"], [54.41102132991869, 56.66000137329102, "الخسارة كيقربكم ولا كيبعدكم؟"]], "dur": 57.36000137329101}