6, "وهادشي كيديروه"], [34.26842097232216, 36.099998474121094, "بجوج: الرجال والعيالات."], [36.099998474121094, 36.75279876708984, "ماشي جنس"], [36.75279876708984, 38.13999938964844, "معين… هادي عادة."], [38.13999938964844, 39.94000053405762, "المشكل؟ السكات العقابي"], [39.94000053405762, 41.7400016784668, "كيعلم الآخر يخاف منك،"], [41.7400016784668, 42.84000015258789, "ماشي يقرب ليك."], [42.84000015258789, 43.56413755745724, "ومع الوقت،"], [43.56413755745724, 44.939998626708984, "كيبني حيط بيناتكم."], [44.939998626708984, 46.09609613185975, "الحل ساهل: سمّي"], [46.09609613185975, 48.099998474121094, "الوقت، ورجع فالوعد ديالك."], [48.099998474121094, 49.42799835205078, "«غادي نتمشى نص"], [49.42799835205078, 51.41999816894531, "ساعة، ونرجعو نكملو.»"], [51.41999816894531, 52.53199920654297, "ورجع فعلا… حيت"], [52.53199920654297, 54.20000076293945, "الثقة كتبنى فالرجوع."], [54.20000076293945, 56.06000022888183, "ونتوما؟ فاش كتزعفو، كتبعدو"], [56.06000022888183, 57.91999969482422, "باش تهدنو ولا باش تعاقبو؟"]], "dur": 58.619999694824216}