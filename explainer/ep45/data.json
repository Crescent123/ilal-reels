, 41.900000461312224, "سول اللي عندو علاقة"], [41.900000461312224, 43.81999969482422, "ناجحة، ماشي اللي مجروح."], [43.81999969482422, 44.55411798813764, "ولا شي مختص،"], [44.55411798813764, 45.900001525878906, "اللي ماشي طرف فالقصة."], [45.900001525878906, 46.86842225727282, "والقاعدة: الخصام"], [46.86842225727282, 48.20000076293945, "الصغير، يبقى بيناتكم."], [48.20000076293945, 49.04275986243938, "حيت العلاقة اللي فيها بزاف"], [49.04275986243938, 50.08000183105469, "ديال الناس، ما كتبقاش ديال جوج."], [50.08000183105469, 51.89543917471902, "ونتوما؟ واش كتحكيو مشاكلكم"], [51.89543917471902, 54.05999908447266, "لصحابكم، ولا كتخليوها بيناتكم؟"]], "dur": 54.75999908447265}